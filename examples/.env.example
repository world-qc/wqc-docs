# Copy to `.env` in this directory and fill before starting the stack:
#   cp .env.example .env
#   docker compose -f compose.yml up -d
#   ./scripts/redis-reseed-operator-pubkeys.sh
#
# Ed25519 private/public pairs (orchestrator + each node):
#   https://github.com/world-qc/wqc-keygen
#
#   docker build -t wqc-keygen https://github.com/world-qc/wqc-keygen.git
#   docker run --rm wqc-keygen generate
#   # or: cargo run -- generate   (in a wqc-keygen checkout)
#
# Orchestrator and p2p-proxy must share the same WQC_ORCHESTRATOR_PRIVATE_KEY.
# Each node needs a unique WQC_NODE_XX_PRIVATE_KEY.
#
# WQC_TESTNET_NODE_KEY (operator identity) is fixed in compose.yml as nk_e2e-node-01…05.
# After stack start, run scripts/redis-reseed-operator-pubkeys.sh to register operator pubkeys in Redis.

# Object store (MinIO)
MINIO_ROOT_USER=<minio-access-key>
MINIO_ROOT_PASSWORD=<minio-secret-key>

# Orchestrator + p2p-proxy (same Ed25519 seed, base64)
WQC_ORCHESTRATOR_PRIVATE_KEY=<base64-ed25519-seed>

# Worker nodes (unique per node — one wqc-keygen generate run each)
WQC_NODE_01_PRIVATE_KEY=<base64-ed25519-seed>
WQC_NODE_02_PRIVATE_KEY=<base64-ed25519-seed>
WQC_NODE_03_PRIVATE_KEY=<base64-ed25519-seed>
WQC_NODE_04_PRIVATE_KEY=<base64-ed25519-seed>
WQC_NODE_05_PRIVATE_KEY=<base64-ed25519-seed>
